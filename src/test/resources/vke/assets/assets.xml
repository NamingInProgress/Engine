<assets>
    <stage-filter uri="file://extension" query="json" op="equals">
        <convert to="config"/>
        <stage-filter uri="file://location/parent" query="language" op="equals">
            <convert to="lang"/>
            <rename>
                <static-part value="language."/>
                <uri-part uri="file://nickname"/>
            </rename>
        </stage-filter>
        <stage-filter uri="file://name" query="pipeline" op="matches">
            <convert to="pipeline"/>
        </stage-filter>
    </stage-filter>
    <stage-filter uri="file://extension" query="frag|fsh" op="matches">
        <convert to="fragshader"/>
        <rename>
            <static-part value="frag."/>
            <uri-part uri="file://nickname"/>
        </rename>
    </stage-filter>
    <stage-filter uri="file://extension" query="vert|vsh" op="matches">
        <convert to="vertshader"/>
        <rename>
            <static-part value="vert."/>
            <uri-part uri="file://nickname"/>
        </rename>
    </stage-filter>
    <stage-filter uri="file://extension" query="png" op="equals">
        <convert to="png"/>
    </stage-filter>
</assets>