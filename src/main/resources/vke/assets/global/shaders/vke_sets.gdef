#extension GL_EXT_nonuniform_qualifier : require

struct Camera {
    mat4 projection;
    mat4 view;
};

#MultipleWrites(2)
layout (set = 0, binding = 0) uniform FrameData {
    Camera camera;
    float time;
} frameData;

layout (set = 1, binding = 0) uniform #DefaultSize(1024) sampler2D textures[];
