#extension GL_EXT_nonuniform_qualifier : require

struct Camera {
    mat4 projection;
    mat4 view;
};

struct Material {
    vec4 baseAlbedo;
    int baseColorId;
    int normalId;
    int specularId;
    int occlusionId;
};

#MultipleWrites(2)
layout (set = 0, binding = 0) uniform FrameData {
    Camera camera;
    float time;
} frameData;

layout (set = 1, binding = 0) uniform #DefaultSize(1024) sampler2D textures[];

layout (set = 2, binding = 0) readonly buffer Materials {
    #DefaultSize(1024)
    Material materials[];
} materialBuffer;

layout (set = 2, binding = 1) uniform #DefaultSize(1024) sampler2D materialTextures[];

vec4 sampleTexture(int id, vec2 uv) {
    return texture(textures[nonuniformEXT(id)], uv);
}

vec4 sampleMaterialTexture(int id, vec2 uv) {
    return texture(materialTextures[nonuniformEXT(id)], uv);
}
