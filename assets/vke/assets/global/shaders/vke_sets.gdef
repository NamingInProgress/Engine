#extension GL_EXT_nonuniform_qualifier : require

const int NO_TEXTURE = -1;

struct Camera {
    mat4 projection;
    mat4 view;
    mat4 inverse_projection;
    mat4 inverse_view;
    vec4 lookAt;
    vec4 position;
};

#MultiWriteHint(3)
layout (set = 0, binding = 0) uniform FrameData {
    Camera camera;
    float time;
} frameData;

layout (set = 1, binding = 0) uniform #DefaultSize(1024) sampler2D textures[];

vec4 vktexture(sampler2D sampl, vec2 uv) {
    return texture(sampl, vec2(uv.x, 1.0 - uv.y));
}

vec4 sampleTexture(int id, vec2 uv) {
    if (id == NO_TEXTURE) return vec4(1);
    return texture(textures[nonuniformEXT(id)], uv);
}

vec3 aces(vec3 x) {
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

vec4 correctColor(vec4 col) {
    vec3 color = col.rgb;
    color *= 1.0;

    return vec4(aces(color), 1.0);
}

vec4 correctColor(vec3 col) {
    return correctColor(vec4(col, 1.0));
}

const float LIMIT = 65536.0;

float handleChannel(float value) {
    return isnan(value) ? LIMIT : (isinf(value) ? LIMIT : value);
}

vec2 handleInvalidValues(vec2 o) {
    return vec2(handleChannel(o.x), handleChannel(o.y));
}

vec3 handleInvalidValues(vec3 o) {
    return vec3(handleChannel(o.x), handleChannel(o.y), handleChannel(o.z));
}

vec4 handleInvalidValues(vec4 o) {
    return vec4(handleChannel(o.x), handleChannel(o.y), handleChannel(o.z), handleChannel(o.w));
}